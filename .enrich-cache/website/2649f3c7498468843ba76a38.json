{"key":"https://abundant.ai","fetchedAt":"2026-11-15T10:41:09.900Z","value":"<!doctype html>\n<html lang=\"en\" data-mode=\"light\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Abundant — Environments and Datasets for Reinforcement Learning</title>\n  <meta name=\"description\" content=\"Environments and datasets for RL. Powering the world's leading AI labs.\" />\n  <link rel=\"canonical\" href=\"https://www.abundant.ai/\" />\n  <link rel=\"alternate\" type=\"text/markdown\" href=\"/index.md\" />\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Forum&display=swap\" rel=\"stylesheet\" />\n  <meta name=\"robots\" content=\"index,follow\" />\n  <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\" />\n  <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\" />\n\n  <link rel=\"icon\" type=\"image/png\" href=\"/logo_black.png\" media=\"(prefers-color-scheme: light)\" />\n  <link rel=\"icon\" type=\"image/png\" href=\"/logo_white.png\" media=\"(prefers-color-scheme: dark)\" />\n  <link rel=\"apple-touch-icon\" href=\"/logo_black.png\" />\n\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"Abundant\" />\n  <meta property=\"og:title\" content=\"abundant — environments and datasets for RL\" />\n  <meta property=\"og:description\" content=\"Environments and datasets for RL. Powering the world's leading AI labs.\" />\n  <meta property=\"og:url\" content=\"https://www.abundant.ai/\" />\n  <meta property=\"og:image\" content=\"https://www.abundant.ai/logo_black.png\" />\n\n  <meta name=\"twitter:card\" content=\"summary\" />\n  <meta name=\"twitter:title\" content=\"abundant — environments and datasets for RL\" />\n  <meta name=\"twitter:description\" content=\"Environments and datasets for RL. Powering the world's leading AI labs.\" />\n  <meta name=\"twitter:image\" content=\"https://www.abundant.ai/logo_black.png\" />\n\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@graph\": [\n      {\n        \"@type\": \"Organization\",\n        \"@id\": \"https://www.abundant.ai/#organization\",\n        \"name\": \"Abundant\",\n        \"url\": \"https://www.abundant.ai/\",\n        \"logo\": \"https://www.abundant.ai/logo_black.png\",\n        \"description\": \"Environments and datasets for RL. Powering the world's leading AI labs.\",\n        \"foundingLocation\": \"San Francisco, CA\"\n      },\n      {\n        \"@type\": \"WebSite\",\n        \"@id\": \"https://www.abundant.ai/#website\",\n        \"name\": \"Abundant\",\n        \"url\": \"https://www.abundant.ai/\",\n        \"publisher\": { \"@id\": \"https://www.abundant.ai/#organization\" }\n      }\n    ]\n  }\n  </script>\n  <script>\n    // Apply persisted color mode early to avoid flash\n    if (localStorage.getItem('darkMode') === 'true') {\n      document.documentElement.setAttribute('data-mode', 'dark');\n    }\n  </script>\n  <script defer src=\"https://cdn.vercel-insights.com/v1/script.js\"></script>\n  <style>\n    :root {\n      --bg: #ffffff;\n      --text: #000000;\n      --muted: #555555;\n      --border: rgba(0, 0, 0, .18);\n      --hover: rgba(128, 128, 128, .10);\n      --logo: url(\"logo_black.png\");\n      --toggle-bg: #000000;\n      --toggle-text: #ffffff;\n    }\n\n    html[data-mode=\"dark\"] {\n      --bg: #000000;\n      --text: #f2f2f2;\n      --muted: #8a8a8a;\n      --border: rgba(255, 255, 255, .18);\n      --hover: rgba(255, 255, 255, .06);\n      --logo: url(\"logo_white.png\");\n      --toggle-bg: #f2f2f2;\n      --toggle-text: #000000;\n    }\n\n    * { box-sizing: border-box; }\n\n    html, body {\n      margin: 0;\n      padding: 0;\n      background: var(--bg);\n      color: var(--text);\n      font-family: \"Forum\", Georgia, serif;\n      font-size: 16px;\n      line-height: 1.6;\n      transition: background-color .4s ease, color .4s ease;\n      scroll-behavior: smooth;\n    }\n\n    body { min-height: 100vh; }\n\n    a { color: inherit; text-decoration: none; }\n\n    /* Centered content column — width sized to the text (~80ch) so the whole block reads as centered on wide screens */\n    main {\n      max-width: 760px;\n      margin: 0 auto;\n      padding: 60px 40px 200px;\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Header row: brand-left, nav-right, aligned to top */\n    .header {\n      margin-bottom: 60px;\n    }\n\n\n\n    /* Body copy — fills the column; the column itself caps the line length */\n    main p {\n      margin: 0 0 32px;\n    }\n\n    ul.bullets {\n      list-style: none;\n      padding: 0;\n      margin: 0 0 32px;\n    }\n    ul.bullets li {\n      position: relative;\n      padding-left: 22px;\n      margin-bottom: 10px;\n    }\n    ul.bullets li::before {\n      content: \"•\";\n      position: absolute;\n      left: 6px;\n      top: 0;\n    }\n\n    /* Floating bottom-right toggle pill */\n    .toggle {\n      position: fixed;\n      bottom: 24px;\n      right: 24px;\n      background: var(--toggle-bg);\n      color: var(--toggle-text);\n      border: 0;\n      padding: 10px 16px;\n      border-radius: 999px;\n      font: inherit;\n      font-size: 13px;\n      cursor: pointer;\n      z-index: 10;\n      transition: background-color .4s ease, color .4s ease, transform .15s ease;\n    }\n    .toggle:hover { transform: translateY(-1px); }\n\n    /* Bottom-left copyright */\n    .copy {\n      position: fixed;\n      bottom: 28px;\n      left: 40px;\n      font-size: 13px;\n      color: var(--muted);\n      z-index: 10;\n    }\n\n    /* Mobile */\n    @media (max-width: 600px) {\n      main { padding: 22px 22px 120px; }\n      .header { margin-bottom: 40px; }\n      .copy { left: 22px; bottom: 22px; }\n      .toggle { right: 16px; bottom: 16px; }\n    }\n\n    /* Selector + email form */\n    .post-letter-tail {\n      opacity: 0;\n      transition: opacity 0.5s ease;\n    }\n    .post-letter-tail.reveal { opacity: 1; }\n    hr.rule {\n      border: 0;\n      border-top: 1px solid var(--border);\n      margin: 28px 0 32px;\n    }\n    .prompt {\n      color: var(--muted);\n      margin: 0 0 16px;\n    }\n    .opts {\n      border: 1px solid var(--border);\n      border-radius: 4px;\n      overflow: hidden;\n      max-width: 80ch;\n    }\n    .opt {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      padding: 13px 18px;\n      font-size: 14px;\n      cursor: pointer;\n      user-select: none;\n      background: transparent;\n      color: var(--text);\n      transition: background-color .15s ease, color .15s ease;\n    }\n    .opt:not(.active):hover { background: var(--hover); }\n    .opt.active {\n      background: var(--text);\n      color: var(--bg);\n    }\n    .opt .marker { display: inline-block; min-width: 3ch; }\n    .email-block { margin-top: 30px; max-width: 80ch; }\n    .field-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 18px 24px;\n    }\n    .field { min-width: 0; }\n    .field.wide { grid-column: 1 / -1; }\n    .field-label { display: block; color: var(--muted); font-size: 13px; }\n    .email-row {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      border-bottom: 1px solid var(--border);\n      padding: 6px 0;\n    }\n    .email-row .caret { font-weight: 700; }\n    .email-row input {\n      flex: 1;\n      background: transparent;\n      border: 0;\n      outline: none;\n      color: var(--text);\n      font: inherit;\n      padding: 4px 0;\n    }\n    .email-row input::placeholder { color: var(--muted); }\n    .confirm {\n      margin-top: 14px;\n      color: var(--muted);\n      font-size: 14px;\n      display: none;\n    }\n    .confirm.show { display: block; }\n    .confirm.error { color: #d1442a; }\n    .legal-footer {\n      display: flex;\n      gap: 18px;\n      margin-top: 42px;\n      color: var(--muted);\n    }\n    .legal-footer a {\n      color: inherit;\n      text-decoration: none;\n      transition: color .15s ease;\n    }\n    .legal-footer a:hover { color: var(--text); }\n\n  </style>\n  <link rel=\"stylesheet\" href=\"/header.css\" />\n  <link rel=\"describedby\" href=\"/llms.txt\" />\n</head>\n<body>\n  <main>\n    <div class=\"header site-header\">\n      <a class=\"site-brand\" href=\"/\" aria-label=\"abundant — home\">\n        <span class=\"site-logo\" role=\"img\" aria-label=\"abundant logo\"></span>\n      </a>\n      <nav class=\"site-nav\" aria-label=\"Primary\">\n        <a href=\"/blog/\">Blog</a>\n        <a href=\"/careers\">Careers</a>\n      </nav>\n    </div>\n\n    <p>Hello! 👋</p>\n\n    <p>We are a team of former ML engineers, founders, and roboticists who obsess about data and its impact on safe, reliable AI.</p>\n\n    <p>We specialize in creating environments and datasets for RL by leveraging our experience in simulation and model training.</p>\n\n    <ul class=\"bullets\">\n      <li>Powering every frontier AI lab and multiple Neolabs</li>\n      <li>Deep in coding, sciences, engineering, RSI, alignment, and robotics</li>\n      <li>Backed by angels from OpenAI, Anthropic, and Google DeepMind</li>\n    </ul>\n\n    <p>We are working towards an abundant future, where everyone has access to safe and infinite intelligence, services and goods.</p>\n\n    <p>Based in San Francisco. We enjoy good food and good company.</p>\n\n    <section class=\"post-letter-tail\">\n    <hr class=\"rule\" />\n\n    <p class=\"prompt\">Contact us (use ↑↓ arrows and Enter to select)</p>\n\n    <div class=\"opts\" role=\"listbox\" aria-label=\"Contact options\" tabindex=\"0\">\n      <div class=\"opt active\" role=\"option\" aria-selected=\"true\" data-value=\"datasets\">\n        <span class=\"marker\">[x]</span><span class=\"label\">Explore our datasets</span>\n      </div>\n      <div class=\"opt\" role=\"option\" aria-selected=\"false\" data-value=\"licensing your data\">\n        <span class=\"marker\">[ ]</span><span class=\"label\">License your data</span>\n      </div>\n      <div class=\"opt\" role=\"option\" aria-selected=\"false\" data-value=\"custom evals &amp; post-training\">\n        <span class=\"marker\">[ ]</span><span class=\"label\">Custom evals &amp; post-training</span>\n      </div>\n      <div class=\"opt\" role=\"option\" aria-selected=\"false\" data-value=\"research opportunities\">\n        <span class=\"marker\">[ ]</span><span class=\"label\">Research opportunities</span>\n      </div>\n    </div>\n\n    <form class=\"email-block\" id=\"email-form\" novalidate>\n      <div class=\"field-grid\">\n        <div class=\"field\">\n          <label class=\"field-label\" for=\"first-name-input\">First name</label>\n          <div class=\"email-row\">\n            <span class=\"caret\">&gt;</span>\n            <input type=\"text\" id=\"first-name-input\" required autocomplete=\"given-name\" spellcheck=\"false\" />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label class=\"field-label\" for=\"last-name-input\">Last name</label>\n          <div class=\"email-row\">\n            <span class=\"caret\">&gt;</span>\n            <input type=\"text\" id=\"last-name-input\" required autocomplete=\"family-name\" spellcheck=\"false\" />\n          </div>\n        </div>\n        <div class=\"field wide\">\n          <label class=\"field-label\" for=\"email-input\">Work email</label>\n          <div class=\"email-row\">\n            <span class=\"caret\">&gt;</span>\n            <input type=\"email\" id=\"email-input\" required autocomplete=\"email\" spellcheck=\"false\" />\n          </div>\n        </div>\n        <div class=\"field wide\">\n          <label class=\"field-label\" for=\"org-input\">Organization</label>\n          <div class=\"email-row\">\n            <span class=\"caret\">&gt;</span>\n            <input type=\"text\" id=\"org-input\" autocomplete=\"organization\" spellcheck=\"false\" />\n          </div>\n        </div>\n      </div>\n      <div class=\"confirm\" id=\"confirm\"></div>\n    </form>\n    </section>\n\n    <footer class=\"legal-footer\">\n      <a href=\"/terms-and-conditions/\">Terms</a>\n      <a href=\"/privacy-notice/\">Privacy</a>\n      <a href=\"/support/\">Support</a>\n    </footer>\n  </main>\n\n  <button class=\"toggle\" id=\"toggle\" type=\"button\" aria-label=\"Toggle color mode\">◐ Toggle Mode</button>\n\n  <script>\n    (function () {\n      const toggle = document.getElementById('toggle');\n      const root = document.documentElement;\n      toggle.addEventListener('click', () => {\n        const next = root.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';\n        root.setAttribute('data-mode', next);\n        localStorage.setItem('darkMode', next === 'dark');\n      });\n\n      const WEB3FORMS_KEY = 'ad480e8d-65db-47ca-8135-d9dded330da6';\n      const opts = Array.from(document.querySelectorAll('.opt'));\n      const firstNameInput = document.getElementById('first-name-input');\n      const lastNameInput = document.getElementById('last-name-input');\n      const emailInput = document.getElementById('email-input');\n      const orgInput = document.getElementById('org-input');\n      const fields = [firstNameInput, lastNameInput, emailInput, orgInput];\n      const form = document.getElementById('email-form');\n      const confirmEl = document.getElementById('confirm');\n      let active = 0;\n\n      function render() {\n        opts.forEach((el, i) => {\n          const isActive = i === active;\n          el.classList.toggle('active', isActive);\n          el.setAttribute('aria-selected', isActive ? 'true' : 'false');\n          el.querySelector('.marker').textContent = isActive ? '[x]' : '[ ]';\n        });\n      }\n\n      opts.forEach((el, i) => {\n        el.addEventListener('click', () => { active = i; render(); });\n      });\n\n      document.addEventListener('keydown', (e) => {\n        // Let Enter confirm IME composition (e.g. CJK names) instead of advancing.\n        if (e.isComposing || e.keyCode === 229) return;\n        const fieldIdx = fields.indexOf(document.activeElement);\n        const inEmail = fieldIdx !== -1;\n        if (e.key === 'ArrowDown') {\n          if (inEmail) return;\n          e.preventDefault();\n          active = (active + 1) % opts.length;\n          render();\n        } else if (e.key === 'ArrowUp') {\n          if (inEmail) return;\n          e.preventDefault();\n          active = (active - 1 + opts.length) % opts.length;\n          render();\n        } else if (e.key === 'Enter') {\n          e.preventDefault();\n          // Enter walks through the fields; on the last one it submits.\n          if (fieldIdx === fields.length - 1) form.requestSubmit();\n          else fields[fieldIdx + 1].focus();\n        }\n      });\n\n      form.addEventListener('submit', (e) => {\n        e.preventDefault();\n        const invalid = fields.find((f) => !f.checkValidity() || (f.required && !f.value.trim()));\n        if (invalid) {\n          confirmEl.className = 'confirm show error';\n          confirmEl.textContent = invalid === emailInput\n            ? '✗ enter a valid work email.'\n            : '✗ fill in your first and last name.';\n          invalid.focus();\n          return;\n        }\n        const selected = opts[active].dataset.value;\n        const firstName = firstNameInput.value.trim();\n        const lastName = lastNameInput.value.trim();\n        const email = emailInput.value.trim();\n        const organization = orgInput.value.trim();\n\n        confirmEl.className = 'confirm show';\n        confirmEl.textContent = 'sending...';\n\n        // Slack notification with @-mentions (api/lead.js); fire-and-forget.\n        fetch('/api/lead', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          keepalive: true,\n          body: JSON.stringify({\n            interest: opts[active].querySelector('.label').textContent,\n            name: firstName + ' ' + lastName,\n            email: email,\n            organization: organization\n          })\n        }).catch(() => {});\n\n        fetch('https://api.web3forms.com/submit', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n          // Keys double as the row labels in the Slack/email notification.\n          body: JSON.stringify({\n            access_key: WEB3FORMS_KEY,\n            subject: '[abundant] new lead — ' + selected,\n            from_name: 'abundant.ai landing form',\n            Interest: opts[active].querySelector('.label').textContent,\n            Name: firstName + ' ' + lastName,\n            Email: email,\n            ...(organization && { Organization: organization })\n          })\n        })\n          .then((r) => r.json())\n          .then((data) => {\n            if (data && data.success) {\n              confirmEl.className = 'confirm show';\n              confirmEl.textContent = `✓ recorded — we'll be in touch shortly about ${selected}.`;\n              fields.forEach((f) => { f.value = ''; });\n            } else {\n              confirmEl.className = 'confirm show error';\n              confirmEl.textContent = '✗ ' + ((data && data.message) || 'send failed') + ' — try again.';\n            }\n          })\n          .catch(() => {\n            confirmEl.className = 'confirm show error';\n            confirmEl.textContent = '✗ network error — try again.';\n          });\n      });\n\n      render();\n    })();\n  </script>\n\n  <style>\n    /* Typewriter reveal */\n    main > p, main > ul.bullets li { visibility: hidden; }\n    .tw-active { visibility: visible !important; }\n    .tw-cursor {\n      display: inline-block;\n      width: 0.55ch;\n      height: 1em;\n      background: currentColor;\n      vertical-align: text-bottom;\n      margin-left: 2px;\n      animation: tw-blink 1s steps(2, end) infinite;\n    }\n    @keyframes tw-blink { 50% { opacity: 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      main > p, main > ul.bullets li { visibility: visible; }\n      .tw-cursor { display: none; }\n    }\n  </style>\n  <script>\n    (function () {\n      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n        document.querySelectorAll('main > p, main > ul.bullets li').forEach(function (el) {\n          el.style.visibility = 'visible';\n        });\n        var tail = document.querySelector('.post-letter-tail');\n        if (tail) tail.classList.add('reveal');\n        return;\n      }\n      var els = Array.prototype.slice.call(document.querySelectorAll('main > p, main > ul.bullets li'));\n      if (!els.length) return;\n\n      var CHAR_MS = 12;\n      var CHARS_PER_TICK = 3;\n      var GAP_MS = 50;\n      var skipped = false;\n      var done = false;\n\n      function revealTail() {\n        var tail = document.querySelector('.post-letter-tail');\n        if (tail) tail.classList.add('reveal');\n      }\n\n      function skipAll() {\n        if (skipped || done) return;\n        skipped = true;\n        els.forEach(function (el) {\n          var text = el.getAttribute('data-tw-text');\n          if (text != null) el.textContent = text;\n          el.classList.add('tw-active');\n          var c = el.querySelector('.tw-cursor');\n          if (c && c.parentNode) c.parentNode.removeChild(c);\n        });\n        revealTail();\n      }\n\n      function typeElement(el, cb) {\n        var text = el.hasAttribute('data-tw-text') ? el.getAttribute('data-tw-text') : el.textContent;\n        if (!el.hasAttribute('data-tw-text')) el.setAttribute('data-tw-text', text);\n        var chars = Array.from(text);\n        el.innerHTML = '';\n        el.classList.add('tw-active');\n        var node = document.createTextNode('');\n        el.appendChild(node);\n        var cursor = document.createElement('span');\n        cursor.className = 'tw-cursor';\n        el.appendChild(cursor);\n\n        var pos = 0;\n        function tick() {\n          if (skipped) return;\n          if (pos >= chars.length) {\n            if (cursor.parentNode) el.removeChild(cursor);\n            cb();\n            return;\n          }\n          node.data += chars.slice(pos, pos + CHARS_PER_TICK).join('');\n          pos += CHARS_PER_TICK;\n          setTimeout(tick, CHAR_MS);\n        }\n        tick();\n      }\n\n      var i = 0;\n      function next() {\n        if (skipped) return;\n        if (i >= els.length) { done = true; revealTail(); return; }\n        typeElement(els[i], function () {\n          i++;\n          setTimeout(next, GAP_MS);\n        });\n      }\n      next();\n\n      // Click anywhere non-interactive → skip to end\n      document.addEventListener('click', function (e) {\n        if (done || skipped) return;\n        if (e.target.closest && e.target.closest('a, button, input, textarea, select, [role=\"button\"]')) return;\n        skipAll();\n      }, true);\n    })();\n  </script>\n</body>\n</html>\n"}