y-button-icon-wrap\"><img style=\"-webkit-transform:translate3d(0%, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0%, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0%, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0%, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)\" loading=\"lazy\" alt=\"Go Button\" src=\"https://cdn.prod.website-files.com/68250c333ddd8f411088a89b/68250c333ddd8f411088a8bc_Arrow%20-%20Down.svg\" class=\"primary-button-icon\" /><img style=\"-webkit-transform:translate3d(-100%, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(-100%, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(-100%, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(-100%, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)\" loading=\"lazy\" alt=\"Go Button\" src=\"https://cdn.prod.website-files.com/68250c333ddd8f411088a89b/68250c333ddd8f411088a8bc_Arrow%20-%20Down.svg\" class=\"primary-button-hover-icon\" /></div>\n                    </div>\n                  </div>\n                </a></div>\n            </div>\n            <div data-w-id=\"ad02d03a-6abc-7c35-6966-4335a25cc91a\" style=\"opacity:0\" class=\"careerbox\"><img src=\"https://cdn.prod.website-files.com/68250c333ddd8f411088a89b/6851ad08bc0ac7d08939d7b2_career-banner.png\" loading=\"lazy\" sizes=\"(max-width: 638px) 100vw, 638px\" srcset=\"https://cdn.prod.website-files.com/68250c333ddd8f411088a89b/6851ad08bc0ac7d08939d7b2_career-banner-p-500.png 500w, https://cdn.prod.website-files.com/68250c333ddd8f411088a89b/6851ad08bc0ac7d08939d7b2_career-banner.png 638w\" alt=\"Career Banner\" class=\"careerbanner\" /></div>\n          </div>\n        </div>\n      </section>\n      <section class=\"careerhealthsection\">\n        <div class=\"careercontainer\">\n          <div class=\"inner-wrap\">\n            <div class=\"career-title-wrap\">\n              <div class=\"inner-title-wrap center\">\n                <div data-w-id=\"bbe95404-5788-91d8-335d-51a667e7fd17\" style=\"opacity:0\" class=\"inner-title-box\">\n                  <h2 class=\"inner-title inner-title-size\">What you can expect <span class=\"text-span-4\">at Axle Health</span></h2>\n                </div>\n                <div data-w-id=\"bbe95404-5788-91d8-335d-51a667e7fd1c\" style=\"opacity:0\" class=\"inner-description-box max-with\">\n                  <p class=\"optimize-description\">From ownership to offsites, we’re building a workplace where your impact, growth, and well being come first.</p>\n                </div>\n              </div>\n            </div>\n            <div data-w-id=\"2557b6c2-e4e3-1d4c-6c7a-a63ea4f87880\" style=\"opacity:0\" class=\"mob-divider for-smart-route\"></div>\n          </div>\n          <div class=\"w-layout-blockcontainer gridcontainer w-container\">\n            <div class=\"w-layout-grid firstgrid\">\n              <div>\n                <h3 class=\"careerh3\">Ownership</h3>\n                <div class=\"description\">Every team member receives equity—so you benefit directly from the impact you help create in transforming home healthcare.</div>\n                <div class=\"hrline\"></div>\n              </div>\n              <div>\n                <h3 class=\"careerh3\">Growth</h3>\n                <div class=\"description\">Join a fast-moving, tight-knit team where you’ll take on meaningful work and develop new skills every day.</div>\n                <div class=\"hrline\"></div>\n              </div>\n              <div>\n                <h3 class=\"careerh3\">Wellness</h3>\n                <div class=\"description\">We offer top-tier medical, dental, and vision coverage, 401k, flexible PTO, and daily lunch at our Santa Monica HQ.</div>\n                <div class=\"hrline\"></div>\n              </div>\n              <div>\n                <h3 class=\"careerh3\">Community</h3>\n                <div class=\"description\">From team lunches to offsites like Magic Castle and Vegas, we invest in bonding experiences that make work more rewarding.</div>\n                <div class=\"hrline\"></div>\n              </div>\n            </div>\n          </div>\n          <div class=\"div-block-16\"><a data-w-id=\"afe7393c-5dad-48a8-8708-8aa75139f0f0\" style=\"opacity:0\" href=\"#jobSection\" class=\"primary-btn w-inline-block\">\n              <div class=\"primary-button-content-2\">\n                <div class=\"primary-button-text-wrap\">\n                  <div style=\"-webkit-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)\" class=\"primary-button-text\">Explore Careers</div>\n                  <div style=\"-webkit-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)\" class=\"primary-button-hover-text\">Explore Careers</div>\n                </div>\n                <div class=\"primary-button-icon-box\">\n                  <div class=\"primary-button-icon-wrap\"><img style=\"-webkit-transform:translate3d(0%, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0%, 0%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-