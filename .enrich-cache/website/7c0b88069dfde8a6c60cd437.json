puts a dependency's CSS ahead of its importer's, which is the\n        // cascade order Vite uses in the HTML it generates for the same entry.\n        const chunks = [];\n        const visited = {};\n        function collectChunks(key) {\n          if (visited[key] === true) {\n            return;\n          }\n          visited[key] = true;\n          const chunk = manifest[key];\n          if (chunk == null) {\n            return;\n          }\n          (chunk.imports ?? []).forEach(collectChunks);\n          chunks.push(chunk);\n        }\n        collectChunks(ENTRY_KEY);\n    \n        // css[] holds output paths, not digests, but every manifest record carries\n        // an integrity for its own file -- so a stylesheet Vite emitted as its own\n        // record can be matched by path. The entry's CSS has no record and loads\n        // unhashed.\n        const integrityByFile = {};\n        Object.keys(manifest).forEach(function (key) {\n          const record = manifest[key];\n          if (record != null && record.file != null && record.integrity != null) {\n            integrityByFile[record.file] = record.integrity;\n          }\n        });\n    \n        const sheets = [];\n        const seenSheets = {};\n        chunks.forEach(function (chunk) {\n          (chunk.css ?? []).forEach(function (sheet) {\n            if (seenSheets[sheet] === true) {\n              return;\n            }\n            seenSheets[sheet] = true;\n            sheets.push(sheet);\n          });\n        });\n    \n        let bundleLoaded = false;\n        function loadBundle() {\n          if (bundleLoaded === true) {\n            return;\n          }\n    \n          const el = document.createElement(\"script\");\n          el.setAttribute(\"type\", \"module\");\n          el.setAttribute(\"crossorigin\", \"\");\n          el.setAttribute(\"integrity\", entryData.integrity);\n          el.setAttribute(\"src\", \"https://cdn.ashbyprd.com/frontend_non_user/b50cb9203b8003693f6b