collectChunks);\n          chunks.push(chunk);\n        }\n        collectChunks(ENTRY_KEY);\n    \n        // css[] holds output paths, not digests, but every manifest record carries\n        // an integrity for its own file -- so a stylesheet Vite emitted as its own\n        // record can be matched by path. The entry's CSS has no record and loads\n        // unhashed.\n        const integrityByFile = {};\n        Object.keys(manifest).forEach(function (key) {\n          const record = manifest[key];\n          if (record != null && record.file != null && record.integrity != null) {\n            integrityByFile[record.file] = record.integrity;\n          }\n        });\n    \n        const sheets = [];\n        const seenSheets = {};\n        chunks.forEach(function (chunk) {\n          (chunk.css ?? []).forEach(function (sheet) {\n            if (seenSheets[sheet] === true) {\n              return;\n            }\n            seenSheets[sheet] = true;\n            sheets.push(sheet);\n          });\n        });\n    \n        let bundleLoaded = false;\n        function loadBundle() {\n          if (bundleLoaded === true) {\n            return;\n          }\n    \n          const el = document.createElement(\"script\");\n          el.setAttribute(\"type\", \"module\");\n          el.setAttribute(\"crossorigin\", \"\");\n          el.setAttribute(\"integrity\", entryData.integrity);\n          el.setAttribute(\"src\", \"https://cdn.ashbyprd.com/frontend_non_user/b50cb9203b8003693f6bceeb8fc9b3209b460d20/\" + entryData.file);\n          document.head.appendChild(el);\n          bundleLoaded = true;\n        }\n    \n        chunks.forEach(function (chunk) {\n          const preload = document.createElement(\"link\");\n          preload.rel = \"modulepreload\";\n          preload.href = \"https://cdn.ashbyprd.com/frontend_non_user/b50cb9203b8003693f6bceeb8fc9b3209b460d20/\" + chunk.file;\n          // Carry the SRI hash on the preload too: Chrome/Firefox reuse the\n          // preloaded bytes for the integrity-bearing script tag, so an integrity-less\n          // preload silently bypasses the SRI check. Without it here, SRI is never\n          // enforced on the code-split chunks (the bulk of the app), in any browser.\n          preload.setAttribute(\"integrity\", chunk.integrity);\n          preload.setAttribute(\"crossorigin\", \"\");\n          document.head.appendChild(preload);\n        });\n    \n        if (sheets.length > 0) {\n          const loadedSheets = [];\n          sheets.forEach(function (sheet) {\n            const link = document.createElement(\"link\");\n            link.rel = \"stylesheet\";\n            link.type = \"text/css\";\n            link.href = \"https://cdn.ashbyprd.com/frontend_non_user/b50cb9203b8003693f6bceeb8fc9b3209b460d20/\" + sheet;\n            link.media = \"all\";\n            const sheetIntegrity = integrityByFile[sheet];\n            if (sheetIntegrity != null) {\n              link.setAttribute(\"integrity\", sheetIntegrity);\n              // SRI on a cross-origin stylesheet requires CORS mode; the CDN sends\n              // access-control-allow-origin: *.\n              link.setAttribute(\"crossorigin\", \"\");\n            }\n            link.onload = function () {\n              loadedSheets.push(sheet);\n              if (loadedSheets.length === sheets.length) {\n                loadBundle();\n              }\n            };\n            link.onerror = loadBundle;\n            document.head.insertBefore(link, document.getElementById(\"vite-preload\"));\n          });\n        } else {\n          loadBundle();\n        }\n      });\n    </script>  </body>\n</html>"}