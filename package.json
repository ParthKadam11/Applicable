{
  "name": "jobfit",
  "version": "0.1.0",
  "description": "Collect startup job postings, tag India remote eligibility, expose via MCP",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/scripts/seed-companies.ts",
    "detect-ats": "tsx src/scripts/detect-ats.ts",
    "ingest:once": "tsx src/scripts/ingest-once.ts",
    "classify:once": "tsx src/scripts/classify-once.ts",
    "classify:fast": "tsx src/scripts/classify-fast.ts",
    "reclassify:open": "tsx src/scripts/reclassify-open.ts",
    "audit:sample": "tsx src/scripts/audit-sample.ts",
    "stats": "tsx src/scripts/stats.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.3",
    "pg-boss": "^10.1.5",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
