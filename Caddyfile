{$MCP_HOST} {
	encode gzip

	handle /health {
		reverse_proxy mcp:3100
	}

	handle /api/* {
		reverse_proxy mcp:3100
	}

	# MCP Streamable HTTP at host root (and legacy /mcp)
	handle {
		reverse_proxy mcp:3100
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	log {
		output stdout
		format console
	}
}
