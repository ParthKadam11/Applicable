{$MCP_HOST} {
	encode gzip

	# MCP Streamable HTTP + health + public REST for the site
	handle /health {
		reverse_proxy mcp:3100
	}

	handle /api/* {
		reverse_proxy mcp:3100
	}

	handle /mcp* {
		reverse_proxy mcp:3100
	}

	handle {
		respond "CaniApply MCP — POST /mcp  GET /health  GET /api/*" 200
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	log {
		output stdout
		format console
	}
}
