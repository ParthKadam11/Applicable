# Postgres
DATABASE_URL=postgres://jobfit:jobfit@localhost:5432/jobfit

# HTTP client
USER_AGENT=JobFit/0.1 (+https://github.com/ParthKadam11/CaniApply; job-board research bot)
HTTP_TIMEOUT_MS=30000
PER_HOST_DELAY_MS=500

# Ingestion / pg-boss
INGEST_CRON=0 */6 * * *
INGEST_CONCURRENCY=5
INGEST_COMPANY_TIMEOUT_MS=30000

# Classification
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.0-flash
# Keep low on Groq free tier (~8k TPM). Raise after upgrading.
CLASSIFY_CONCURRENCY=1
LLM_RPM=6

# Company research (not wired yet — reserved)
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=
BRAVE_API_KEY=

# MCP (not wired yet — reserved)
MCP_HTTP_PORT=3100
