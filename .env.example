# =============================================================================
# CaniApply — copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# =============================================================================

# --- Postgres (docker-compose.prod.yml) ---
POSTGRES_USER=caniapply
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=caniapply
# Used by local dev / scripts on the host. In Docker, compose builds DATABASE_URL
# from POSTGRES_* above pointing at the postgres service.
DATABASE_URL=postgres://caniapply:change-me-to-a-long-random-string@localhost:5432/caniapply

# --- Public hostname for Caddy (HTTPS) ---
# Point DNS A/AAAA for this host at your VPS before compose up.
MCP_HOST=mcp.example.com
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_HTTP_PORT=3100
MCP_RATE_LIMIT_RPM=60
# Legacy alias (optional)
MCP_DOMAIN=mcp.example.com

# --- HTTP client (ATS fetch) ---
USER_AGENT=CaniApply/0.1 (+https://github.com/ParthKadam11/CaniApply; job-board research bot)
HTTP_TIMEOUT_MS=30000
PER_HOST_DELAY_MS=500

# --- Ingestion / pg-boss ---
INGEST_CRON=0 */6 * * *
INGEST_CONCURRENCY=5
INGEST_COMPANY_TIMEOUT_MS=30000

# --- Classification (free-tier LLM rotation; leave keys empty for rules-only) ---
LLM_PROVIDERS=gemini,groq,openrouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it:free
CLASSIFY_CONCURRENCY=4
LLM_RPM=30
LLM_STATE_PATH=.llm-state.json
# Optional local Ollama (usually unset on VPS)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- Company discovery ---
DISCOVER_CRON=0 6 * * 1
DISCOVER_PROMOTE_LIMIT=300
DISCOVER_PROMOTE_CONCURRENCY=5
YC_ALGOLIA_API_KEY=

# --- Company research (reserved; optional) ---
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=
BRAVE_API_KEY=
