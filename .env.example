# Postgres
DATABASE_URL=postgres://jobfit:jobfit@localhost:5432/jobfit

# HTTP client
USER_AGENT=JobFit/0.1 (+https://github.com/ParthKadam11/CaniApply; job-board research bot)
HTTP_TIMEOUT_MS=30000
PER_HOST_DELAY_MS=500

# Ingestion / pg-boss
INGEST_CRON=0 */6 * * *
INGEST_CONCURRENCY=5
INGEST_COMPANY_TIMEOUT_MS=30000

# Classification — free-tier LLM rotation (skip providers with missing keys)
# Order tried on each LLM call; daily/TPD 429 rotates to the next.
# Free-tier order. Omit ollama unless installed (`ollama serve`).
LLM_PROVIDERS=gemini,groq,openrouter
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it:free
CLASSIFY_CONCURRENCY=4
LLM_RPM=30
LLM_STATE_PATH=.llm-state.json

# Company research (not wired yet — reserved)
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=
BRAVE_API_KEY=

# MCP (not wired yet — reserved)
MCP_HTTP_PORT=3100

# Company discovery (weekly Monday 06:00 UTC by default)
DISCOVER_CRON=0 6 * * 1
DISCOVER_PROMOTE_LIMIT=80
# Optional override if YC rotates their public search key
YC_ALGOLIA_API_KEY=
